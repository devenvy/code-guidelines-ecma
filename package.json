{
  "name": "@devenvy/code-guidelines",
  "version": "0.0.0",
  "description": "DevEnvy code guidelines for JavaScript, TypeScript and Angular: ESLint, Prettier, tsconfig bases and a repo baseline CLI.",
  "license": "MIT",
  "author": "DevEnvy",
  "homepage": "https://github.com/devenvy/code-guidelines-ecma#readme",
  "bugs": "https://github.com/devenvy/code-guidelines-ecma/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devenvy/code-guidelines-ecma.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "prettier",
    "tsconfig",
    "angular",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@12.11.2",
  "bin": {
    "code-guidelines": "./src/cli/bin.mjs"
  },
  "exports": {
    "./eslint": {
      "types": "./types/eslint/index.d.mts",
      "default": "./src/eslint/index.mjs"
    },
    "./prettier": {
      "types": "./types/prettier/index.d.mts",
      "default": "./src/prettier/index.mjs"
    },
    "./prettier/angular": {
      "types": "./types/prettier/angular.d.mts",
      "default": "./src/prettier/angular.mjs"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/browser.json": "./tsconfig/browser.json",
    "./tsconfig/angular.json": "./tsconfig/angular.json",
    "./tsconfig/js.json": "./tsconfig/js.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tsconfig",
    "templates",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "test:ci": "vitest run",
    "build:types": "tsc -p tsconfig.build.json",
    "check:package": "pnpm run build:types && publint --strict --pack pnpm && attw --pack . --profile esm-only",
    "prepack": "pnpm run build:types",
    "guidelines:check": "code-guidelines check",
    "rules:report": "node scripts/rules-report.mjs"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": "^1.6.27",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "angular-eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@arethetypeswrong/cli": "^0.18.5",
    "@devenvy/code-guidelines": "link:.",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "prettier": "@devenvy/code-guidelines/prettier",
  "codeGuidelines": {
    "env": "node",
    "typescript": true,
    "angular": false,
    "vitest": true
  }
}
