{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "DevEnvy plain JavaScript",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler"
  }
}
